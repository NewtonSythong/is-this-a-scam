# Both are optional. A missing key degrades the Check rather than breaking it:
# with neither, the deterministic rules still return a complete Verdict.

# Enables the Narrative Check — the half that catches scams with no link in them,
# such as "Hi Mum, this is my new number". https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Enables Safe Browsing lookups and shortened-link expansion. Free for
# non-commercial use. https://developers.google.com/safe-browsing
SAFE_BROWSING_API_KEY=
